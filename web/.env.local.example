// Supabase 配置模板
// 复制此文件为 .env.local 并填写你的 Supabase 凭证

// 方式1: 从 Supabase Dashboard 获取
// 1. 访问 https://supabase.com/dashboard
// 2. 创建新项目
// 3. Project Settings > API
// 4. 复制 URL 和 anon key

// 方式2: 使用 Supabase CLI
// npx supabase link
// npx supabase env > .env

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

// 可选: 服务端密钥（仅用于服务端API路由）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

// Auth 配置
NEXT_PUBLIC_SUPABASE_AUTH_URL=https://your-project.supabase.co/auth/v1
NEXT_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback